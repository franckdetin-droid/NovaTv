{% extends "base.html" %}

{% block title %}
Caméra Live - MY TV APP
{% endblock %}

{% block content %}

<section class="live-page">

<div class="live-topbar">

    <div class="live-title">

        <h1>🎥 MY TV LIVE</h1>

        <p>Diffusez votre contenu en direct.</p>

    </div>

    <div class="live-info">

        <span id="liveStatus" class="offline">
            ⏹ Hors ligne
        </span>

        <span id="serverStatus">
            🟡 Connexion...
        </span>

        <span class="viewer-counter">
            👀
            <span id="viewerCount">0</span>
        </span>

    </div>

</div>

<div class="live-container">

    <!-- VIDEO PRINCIPALE -->

    <div class="main-live">

        <div class="video-wrapper">

            <video
                id="camera"
                autoplay
                playsinline
                muted>
            </video>

            <div class="live-overlay">

                <div class="creator-name">

                    🔴 EN DIRECT

                </div>

                <div class="quality">

                    HD

                </div>

            </div>

        </div>

        <div class="live-controls">

            <button id="startBtn" class="live-btn start">
                🔴 Démarrer
            </button>

            <button id="stopBtn" class="live-btn stop">
                ⛔ Arrêter
            </button>

            <button id="muteBtn" class="live-btn">
                🎤 Micro
            </button>

            <button id="cameraBtn" class="live-btn">
                📷 Caméra
            </button>

            <button id="switchBtn" class="live-btn">
                🔄 Caméra
            </button>

            <button id="screenBtn" class="live-btn">
                🖥 Écran
            </button>

            <button id="fullscreenBtn" class="live-btn">
                ⛶ Plein écran
            </button>

        </div>

        <p id="message">

            Prêt à diffuser.

        </p>

    </div>

    <!-- INVITÉS -->

    <aside class="guests-panel">

        <h3>

            👥 Invités

        </h3>

        <div id="guestGrid" class="guest-grid">

            <div class="guest-empty">

                Aucun invité connecté.

            </div>

        </div>

    </aside>

  </div>
      <!-- ==========================
         COLONNE DROITE
    =========================== -->

    <aside class="live-sidebar">

        <!-- CHAT -->

        <div class="chat-panel">

            <div class="panel-header">

                💬 Chat en direct

            </div>

            <div
                id="chatMessages"
                class="chat-messages">

                <div class="system-message">

                    Bienvenue sur MY TV LIVE.

                </div>

            </div>

            <div class="chat-input">

                <input
                    id="chatText"
                    type="text"
                    placeholder="Écrire un message...">

                <button id="sendChat">

                    Envoyer

                </button>

            </div>

        </div>

        <!-- REACTIONS -->

        <div class="reaction-panel">

            <div class="panel-header">

                ❤️ Réactions

            </div>

            <div class="reaction-buttons">

                <button class="reaction-btn" data-emoji="❤️">
                    ❤️
                </button>

                <button class="reaction-btn" data-emoji="😂">
                    😂
                </button>

                <button class="reaction-btn" data-emoji="🔥">
                    🔥
                </button>

                <button class="reaction-btn" data-emoji="👏">
                    👏
                </button>

                <button class="reaction-btn" data-emoji="👍">
                    👍
                </button>

                <button class="reaction-btn" data-emoji="😍">
                    😍
                </button>

            </div>

            <div
                id="floatingReactions"
                class="floating-reactions">

            </div>

        </div>

        <!-- DEMANDES -->

        <div class="request-panel">

            <div class="panel-header">

                ✋ Demandes d'invitation

            </div>

            <div
                id="requestList"
                class="request-list">

                <div class="empty-request">

                    Aucune demande.

                </div>

            </div>

        </div>

    </aside>

</div>

</section>

<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>

<script>

const socket = io({

    reconnection:true

});

let stream = null;

let room = null;

let peers = {};

let screenSharing = false;

let currentCamera = "user";

const video = document.getElementById("camera");

const liveStatus = document.getElementById("liveStatus");

const serverStatus = document.getElementById("serverStatus");

const viewerCount = document.getElementById("viewerCount");

const guestGrid = document.getElementById("guestGrid");

const requestList = document.getElementById("requestList");

const floatingReactions =
document.getElementById("floatingReactions");

const chatMessages =
document.getElementById("chatMessages");

const message =
document.getElementById("message");
  // ======================================================
// CONNEXION SOCKET
// ======================================================

socket.on("connect",()=>{

    serverStatus.innerHTML="🟢 Serveur connecté";

});

socket.on("disconnect",()=>{

    serverStatus.innerHTML="🔴 Serveur déconnecté";

});

// ======================================================
// CREATION PEER WEBRTC
// ======================================================

function createPeer(id){

    const peer = new RTCPeerConnection({

        iceServers:[

            {

                urls:[
                    "stun:stun.l.google.com:19302"
                ]

            }

        ]

    });

    // Envoyer caméra + micro

    if(stream){

        stream.getTracks().forEach(track=>{

            peer.addTrack(track,stream);

        });

    }

    // Recevoir la vidéo d'un invité

    peer.ontrack=(event)=>{

        let card=document.getElementById("guest-"+id);

        if(!card){

            if(document.querySelector(".guest-empty")){

                document.querySelector(".guest-empty").remove();

            }

            card=document.createElement("div");

            card.className="guest-card";

            card.id="guest-"+id;

            const guestVideo=document.createElement("video");

            guestVideo.autoplay=true;

            guestVideo.playsInline=true;

            guestVideo.srcObject=event.streams[0];

            const guestName=document.createElement("span");

            guestName.innerHTML="👤 Invité";

            card.appendChild(guestVideo);

            card.appendChild(guestName);

            guestGrid.appendChild(card);

        }

    };

    // ICE

    peer.onicecandidate=(event)=>{

        if(event.candidate){

            socket.emit("camera_ice",{

                target:id,

                candidate:event.candidate

            });

        }

    };

    peers[id]=peer;

    return peer;

}

// ======================================================
// NOUVEAU SPECTATEUR
// ======================================================

socket.on("viewer_joined",async(data)=>{

    viewerCount.innerHTML=data.count;

    const peer=createPeer(data.viewer_id);

    const offer=await peer.createOffer();

    await peer.setLocalDescription(offer);

    socket.emit("camera_offer",{

        room:room,

        target:data.viewer_id,

        offer:offer

    });

});

// ======================================================
// RECEVOIR OFFER
// ======================================================

socket.on("camera_offer",async(data)=>{

    const peer=createPeer(data.sender);

    await peer.setRemoteDescription(

        new RTCSessionDescription(data.offer)

    );

    const answer=await peer.createAnswer();

    await peer.setLocalDescription(answer);

    socket.emit("camera_answer",{

        target:data.sender,

        answer:answer

    });

});

// ======================================================
// RECEVOIR ANSWER
// ======================================================

socket.on("camera_answer",async(data)=>{

    if(peers[data.sender]){

        await peers[data.sender].setRemoteDescription(

            new RTCSessionDescription(data.answer)

        );

    }

});
  // ======================================================
// ICE CANDIDATES
// ======================================================

socket.on("camera_ice", async(data)=>{

    try{

        if(peers[data.sender]){

            await peers[data.sender].addIceCandidate(

                new RTCIceCandidate(data.candidate)

            );

        }

    }catch(err){

        console.log(err);

    }let peers = {};
let pendingIce = {};




    while(pendingIce[id].length){

        await peers[id].addIceCandidate(

            pendingIce[id].shift()

        );

    }

}



// ======================================================
// NOUVEAU SPECTATEUR
// ======================================================

socket.on("viewer_joined",async(data)=>{


    viewerCount.innerHTML=data.count;


    const id=data.viewer_id;


    const peer=createPeer(id);


    const offer=await peer.createOffer();


    await peer.setLocalDescription(offer);



    socket.emit("camera_offer",{

        target:id,

        offer:offer

    });


})


// ======================================================
// CREATION PEER WEBRTC
// ======================================================

function createPeer(id){

    const peer = new RTCPeerConnection({

        iceServers:[

            {
                urls:[
                    "stun:stun.l.google.com:19302",
                    "stun:stun1.l.google.com:19302"
                ]
            }

        ]

    });


    if(stream){

        stream.getTracks().forEach(track=>{

            peer.addTrack(track, stream);

        });

    }


    peer.ontrack=(event)=>{

        let card=document.getElementById("guest-"+id);


        if(!card){

            if(document.querySelector(".guest-empty")){

                document.querySelector(".guest-empty").remove();

            }


            card=document.createElement("div");

            card.className="guest-card";

            card.id="guest-"+id;


            const guestVideo=document.createElement("video");

            guestVideo.autoplay=true;
            guestVideo.playsInline=true;
            guestVideo.srcObject=event.streams[0];


            const name=document.createElement("span");

            name.innerHTML="👤 Invité";


            card.appendChild(guestVideo);
            card.appendChild(name);


            guestGrid.appendChild(card);

        }

    };


    peer.onicecandidate=(event)=>{

        if(event.candidate){

            socket.emit("camera_ice",{

                target:id,

                candidate:event.candidate

            });

        }

    };


    peers[id]=peer;

    pendingIce[id]=[];


    return peer;

}



// ======================================================
// AJOUT ICE EN ATTENTE
// ======================================================

async function addPendingIce(id){

    if(!pendingIce[id]) return;


    while(pendingIce[id].length){

        await peers[id].addIceCandidate(

            pendingIce[id].shift()

        );

    }

}



// ======================================================
// NOUVEAU SPECTATEUR
// ======================================================

socket.on("viewer_joined",async(data)=>{


    viewerCount.innerHTML=data.count;


    const id=data.viewer_id;


    const peer=createPeer(id);


    const offer=await peer.createOffer();


    await peer.setLocalDescription(offer);



    socket.emit("camera_offer",{

        target:id,

        offer:offer

    });


});



// ======================================================
// INVITE ACCEPTE
// ======================================================

socket.on("guest_joined",async(data)=>{


    const id=data.guest;


    const peer=createPeer(id);



    const offer=await peer.createOffer();


    await peer.setLocalDescription(offer);



    socket.emit("camera_offer",{

        target:id,

        offer:offer

    });


});



// ======================================================
// RECEVOIR ANSWER
// ======================================================

socket.on("camera_answer",async(data)=>{


    const peer=peers[data.sender];


    if(peer){

        await peer.setRemoteDescription(

            new RTCSessionDescription(data.answer)

        );


        await addPendingIce(data.sender);

    }


});



// ======================================================
// RECEVOIR ICE
// ======================================================

socket.on("camera_ice",async(data)=>{


    const id=data.sender;


    if(peers[id] && peers[id].remoteDescription){


        await peers[id].addIceCandidate(

            new RTCIceCandidate(data.candidate)

        );


    }else{


        if(!pendingIce[id]){

            pendingIce[id]=[];

        }


        pendingIce[id].push(

            new RTCIceCandidate(data.candidate)

        );


    }


});

// ======================================================
// DEMARRER LE LIVE
// ======================================================

document.getElementById("startBtn").onclick = async()=>{

    try{

        stream = await navigator.mediaDevices.getUserMedia({

            video:{
                width:1280,
                height:720,
                facingMode:currentCamera
            },

            audio:true

        });

        video.srcObject = stream;

        await video.play();

        const response = await fetch("/start-camera-live",{

            method:"POST"

        });

        const data = await response.json();

        if(data.success){

            room = "camera_live_" + data.live_id;

            socket.emit("join_camera",{

                room:room,

                creator:true

            });

            liveStatus.innerHTML="🔴 EN DIRECT";

            liveStatus.classList.add("live-active");

            message.innerHTML="✅ Live démarré.";

        }else{

            message.innerHTML="❌ Impossible de démarrer.";

        }

    }catch(error){

        console.log(error);

        message.innerHTML="❌ "+error.message;

    }

};

// ======================================================
// ARRETER LE LIVE
// ======================================================

document.getElementById("stopBtn").onclick=()=>{

    if(stream){

        stream.getTracks().forEach(track=>track.stop());

        stream=null;

    }

    Object.values(peers).forEach(peer=>{

        peer.close();

    });

    peers={};

    if(room){

        socket.emit("stop_camera",{

            room:room

        });

    }

    video.srcObject=null;

    guestGrid.innerHTML=`

        <div class="guest-empty">

            Aucun invité connecté.

        </div>

    `;

    viewerCount.innerHTML="0";

    liveStatus.innerHTML="⛔ Hors ligne";

    liveStatus.classList.remove("live-active");

    message.innerHTML="Live arrêté.";

};

// ======================================================
// PLEIN ECRAN
// ======================================================

document.getElementById("fullscreenBtn").onclick=()=>{

    if(video.requestFullscreen){

        video.requestFullscreen();

    }

};

// ======================================================
// MICRO ON/OFF
// ======================================================

document.getElementById("muteBtn").onclick=()=>{

    if(!stream) return;

    const audio=stream.getAudioTracks()[0];

    audio.enabled=!audio.enabled;

    document.getElementById("muteBtn").innerHTML=

        audio.enabled

        ?

        "🎤 Micro"

        :

        "🔇 Micro";

};

// ======================================================
// CAMERA ON/OFF
// ======================================================

document.getElementById("cameraBtn").onclick=()=>{

    if(!stream) return;

    const cam=stream.getVideoTracks()[0];

    cam.enabled=!cam.enabled;

    document.getElementById("cameraBtn").innerHTML=

        cam.enabled

        ?

        "📷 Caméra"

        :

        "🚫 Caméra";

};
  // ======================================================
// CHANGER DE CAMERA (Mobile)
// ======================================================

document.getElementById("switchBtn").onclick = async()=>{

    if(!stream) return;

    stream.getTracks().forEach(track=>track.stop());

    currentCamera =

        currentCamera==="user"

        ?

        "environment"

        :

        "user";

    stream = await navigator.mediaDevices.getUserMedia({

        video:{
            facingMode:currentCamera
        },

        audio:true

    });

    video.srcObject = stream;

    // Remplacer les pistes vidéo/audio
    Object.values(peers).forEach(peer=>{

        const senders = peer.getSenders();

        stream.getTracks().forEach(track=>{

            const sender = senders.find(s=>

                s.track &&
                s.track.kind===track.kind

            );

            if(sender){

                sender.replaceTrack(track);

            }

        });

    });

};

// ======================================================
// PARTAGE D'ECRAN
// ======================================================

document.getElementById("screenBtn").onclick = async()=>{

    try{

        const display =

        await navigator.mediaDevices.getDisplayMedia({

            video:true

        });

        const screenTrack =
        display.getVideoTracks()[0];

        video.srcObject = display;

        Object.values(peers).forEach(peer=>{

            const sender = peer.getSenders().find(s=>

                s.track &&
                s.track.kind==="video"

            );

            if(sender){

                sender.replaceTrack(screenTrack);

            }

        });

        screenTrack.onended=()=>{

            document.getElementById("switchBtn").click();

        };

    }catch(e){

        console.log(e);

    }

};

// ======================================================
// ENVOYER MESSAGE
// ======================================================

document.getElementById("sendChat").onclick=()=>{

    const input =
    document.getElementById("chatText");

    if(input.value.trim()==="") return;

    socket.emit("live_message",{

        room:room,

        message:input.value

    });

    input.value="";

};

// ======================================================
// RECEVOIR MESSAGE
// ======================================================

socket.on("live_message",(data)=>{

    const div =
    document.createElement("div");

    div.className="chat-item";

    div.innerHTML=

    "<b>"+data.user+"</b> : "+data.message;

    chatMessages.appendChild(div);

    chatMessages.scrollTop=

    chatMessages.scrollHeight;

});

// ======================================================
// ENTRÉE = ENVOYER
// ======================================================

document.getElementById("chatText")

.addEventListener("keypress",(e)=>{

    if(e.key==="Enter"){

        e.preventDefault();

        document.getElementById("sendChat").click();

    }

});
  // ======================================================
// ENVOYER UNE REACTION
// ======================================================

document.querySelectorAll(".reaction-btn").forEach(btn=>{

    btn.onclick=()=>{

        socket.emit("live_reaction",{

            room:room,

            emoji:btn.dataset.emoji

        });

    };

});

// ======================================================
// RECEVOIR UNE REACTION
// ======================================================

socket.on("live_reaction",(data)=>{

    const emoji=document.createElement("div");

    emoji.className="floating-emoji";

    emoji.innerHTML=data.emoji;

    emoji.style.left=Math.random()*80+10+"%";

    floatingReactions.appendChild(emoji);

    setTimeout(()=>{

        emoji.remove();

    },3000);

});

// ======================================================
// DEMANDER A REJOINDRE LE LIVE
// ======================================================

function requestJoinLive(){

    if(!room) return;

    socket.emit("request_join_live",{

        room:room

    });

}

// ======================================================
// LE CREATEUR RECOIT UNE DEMANDE
// ======================================================

socket.on("join_request",(data)=>{

    if(document.querySelector(".empty-request")){

        document.querySelector(".empty-request").remove();

    }

    const card=document.createElement("div");

    card.className="request-card";

    card.id="request-"+data.guest;

    card.innerHTML=`

        <span>

            👤 ${data.guest.substring(0,6)}

        </span>

        <div>

            <button class="accept-btn">

                ✅

            </button>

            <button class="reject-btn">

                ❌

            </button>

        </div>

    `;

    requestList.appendChild(card);

    // ACCEPTER

    card.querySelector(".accept-btn").onclick=()=>{

        socket.emit("accept_guest",{

            room:room,

            guest:data.guest

        });

        card.remove();

    };

    // REFUSER

    card.querySelector(".reject-btn").onclick=()=>{

        card.remove();

    };

});

// ======================================================
// INVITE ACCEPTE
// ======================================================

socket.on("guest_accepted",()=>{

    message.innerHTML="🎉 Vous avez rejoint le live comme invité.";

});

// ======================================================
// INVITE CONNECTE
// ======================================================

socket.on("guest_joined",(data)=>{

    console.log("Nouvel invité :",data.guest);

});

// ======================================================
// INVITE QUITTE
// ======================================================

socket.on("guest_left",(data)=>{

    const card=document.getElementById(

        "guest-"+data.id

    );

    if(card){

        card.remove();

    }

    if(document.querySelectorAll(".guest-card").length===0){

        guestGrid.innerHTML=`

            <div class="guest-empty">

                Aucun invité connecté.

            </div>

        `;

    }

});

// ======================================================
// INVITE EXCLU
// ======================================================

socket.on("kicked",()=>{

    alert("Vous avez été retiré du live.");

    if(stream){

        stream.getTracks().forEach(track=>track.stop());

    }

    window.location.reload();

});
  // ======================================================
// RACCOURCIS CLAVIER
// ======================================================

document.addEventListener("keydown",(e)=>{

    switch(e.key.toLowerCase()){

        case "f":

            document.getElementById("fullscreenBtn").click();

            break;

        case "m":

            document.getElementById("muteBtn").click();

            break;

        case "v":

            document.getElementById("cameraBtn").click();

            break;

        case "c":

            document.getElementById("switchBtn").click();

            break;

        case "s":

            document.getElementById("screenBtn").click();

            break;

    }

});

// ======================================================
// RECONNEXION AUTOMATIQUE
// ======================================================

socket.io.on("reconnect",()=>{

    serverStatus.innerHTML="🟢 Reconnecté";

    if(room){

        socket.emit("join_camera",{

            room:room,

            creator:true

        });

    }

});

// ======================================================
// CAMERA STOPPEE PAR LE SERVEUR
// ======================================================

socket.on("camera_stopped",()=>{

    liveStatus.innerHTML="⛔ Live terminé";

    liveStatus.classList.remove("live-active");

    message.innerHTML="Le direct est terminé.";

});

// ======================================================
// MISE A JOUR DU NOMBRE DE SPECTATEURS
// ======================================================

socket.on("viewer_count",(data)=>{

    viewerCount.innerHTML=data.count;

});

// ======================================================
// QUALITE VIDEO
// ======================================================

const quality={

    width:{ideal:1280},

    height:{ideal:720},

    frameRate:{ideal:30,max:60},

    facingMode:currentCamera

};

// ======================================================
// DETECTION HORS LIGNE
// ======================================================

window.addEventListener("offline",()=>{

    message.innerHTML="📡 Connexion Internet perdue.";

});

window.addEventListener("online",()=>{

    message.innerHTML="🌐 Connexion rétablie.";

});

// ======================================================
// EMPÊCHER LA MISE EN VEILLE (si supporté)
// ======================================================

let wakeLock=null;

async function keepScreenAwake(){

    try{

        if("wakeLock" in navigator){

            wakeLock=

            await navigator.wakeLock.request("screen");

        }

    }catch(e){

        console.log(e);

    }

}

keepScreenAwake();

// ======================================================
// QUITTER LA PAGE
// ======================================================

window.addEventListener("beforeunload",()=>{

    if(room){

        socket.emit("stop_camera",{

            room:room

        });

    }

});
  // ======================================================
// SURVEILLANCE DE LA CONNEXION
// ======================================================

setInterval(()=>{

    if(socket.connected){

        serverStatus.innerHTML="🟢 Serveur connecté";

    }else{

        serverStatus.innerHTML="🔴 Reconnexion...";

    }

},3000);

// ======================================================
// ACTUALISATION DES STATISTIQUES
// ======================================================

setInterval(()=>{

    if(room){

        socket.emit("live_stats",{

            room:room

        });

    }

},10000);

// ======================================================
// RECEVOIR LES STATISTIQUES
// ======================================================

socket.on("live_stats",(data)=>{

    if(data.viewer_count!==undefined){

        viewerCount.innerHTML=data.viewer_count;

    }

});

// ======================================================
// GESTION DES ERREURS WEBRTC
// ======================================================

window.addEventListener("error",(e)=>{

    console.log("Erreur :",e.message);

});

window.addEventListener("unhandledrejection",(e)=>{

    console.log("Promesse rejetée :",e.reason);

});

// ======================================================
// FERMETURE DES CONNEXIONS
// ======================================================

function closeAllPeers(){

    Object.values(peers).forEach(peer=>{

        try{

            peer.close();

        }catch(e){}

    });

    peers={};

}

window.addEventListener("beforeunload",()=>{

    closeAllPeers();

    if(stream){

        stream.getTracks().forEach(track=>track.stop());

    }

});

// ======================================================
// INITIALISATION
// ======================================================

console.log("🎥 MY TV Live prêt.");

</script>

{% endblock %}
